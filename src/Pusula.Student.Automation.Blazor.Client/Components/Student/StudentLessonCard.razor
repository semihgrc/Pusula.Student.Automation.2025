@using Pusula.Student.Automation.StudentPortal
@using Pusula.Student.Automation.Enums
@using Syncfusion.Blazor.Grids

<div class="card shadow-sm mb-4">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <div class="fw-bold">@Lesson.LessonName</div>
            <small class="text-muted">
                @if (!string.IsNullOrWhiteSpace(Lesson.TeacherTitle))
                {
                    @($"{Lesson.TeacherTitle} ")
                }
                @Lesson.TeacherName
            </small>
        </div>
        <span class="badge bg-secondary">@Lesson.Status</span>
    </div>
    <div class="card-body">
        <div class="row g-4">
            <div class="col-lg-4">
                <h6 class="text-uppercase text-muted small">Genel Bilgiler</h6>
                <ul class="list-unstyled mb-0">
                    <li><strong>Dönem Notu:</strong> @FormatDecimal(Lesson.Grade)</li>
                    <li><strong>Vize:</strong> @FormatDecimal(Lesson.MidtermGrade)</li>
                    <li><strong>Final:</strong> @FormatDecimal(Lesson.FinalGrade)</li>
                    <li><strong>Devamsızlık:</strong> @Lesson.AbsenceCount</li>
                </ul>
                @if (!Lesson.TeacherComment.IsNullOrWhiteSpace())
                {
                    <div class="mt-3">
                        <div class="text-muted small">Öğretmen Yorumu</div>
                        <div>@Lesson.TeacherComment</div>
                    </div>
                }
            </div>
            <div>
                <div>Günlük Raporlar</div>
                <SfGrid TItem="StudentDailyReportEntryDto"
                        DataSource="Lesson.DailyReports">
                    <GridTemplates>
                        <EmptyRecordTemplate>
                            <div>Bu ders için rapor oluşturmadınız.</div>
                        </EmptyRecordTemplate>
                    </GridTemplates>
                    <GridColumns>
                        <GridColumn Field="Date"
                                    HeaderText="Tarih"
                                    Type="ColumnType.Date"
                                    Format="dd.MM.yyyy"/>
                        <GridColumn HeaderText="Durum-Not">
                            <Template>
                                @{
                                    var r = (context as StudentDailyReportEntryDto)!;
                                }
                                <span class="muted">
                                    @(r.IsPresent ? "Geldi" : "Gelmedi")
                                    @if (r.DailyGrade.HasValue)
                                    {
                                        <span> | Not: @r.DailyGrade!.Value.ToString("0.##")</span>
                                    }
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="DailyComment"
                                    HeaderText="Yorum" />
                        <GridColumn HeaderText=""
                                    TextAlign="TextAlign.Right">
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public StudentLessonDashboardDto Lesson { get; set; } = default!;

    private static string FormatDecimal(decimal? value)
    {
        return value.HasValue ? value.Value.ToString("0.##") : "-";
    }
}
