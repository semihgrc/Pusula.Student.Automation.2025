@using Pusula.Student.Automation.StudentPortal
@using Pusula.Student.Automation.Enums

<div class="card shadow-sm mb-4">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <div class="fw-bold">@Lesson.LessonName</div>
            <small class="text-muted">
                @if (!string.IsNullOrWhiteSpace(Lesson.TeacherTitle))
                {
                    @($"{Lesson.TeacherTitle} ")
                }
                @Lesson.TeacherName
            </small>
        </div>
        <span class="badge bg-secondary">@Lesson.Status</span>
    </div>
    <div class="card-body">
        <div class="row g-4">
            <div class="col-lg-4">
                <h6 class="text-uppercase text-muted small">Genel Bilgiler</h6>
                <ul class="list-unstyled mb-0">
                    <li><strong>Dönem Notu:</strong> @FormatDecimal(Lesson.Grade)</li>
                    <li><strong>Vize:</strong> @FormatDecimal(Lesson.MidtermGrade)</li>
                    <li><strong>Final:</strong> @FormatDecimal(Lesson.FinalGrade)</li>
                    <li><strong>Devamsızlık:</strong> @Lesson.AbsenceCount</li>
                </ul>
                @if (!Lesson.TeacherComment.IsNullOrWhiteSpace())
                {
                    <div class="mt-3">
                        <div class="text-muted small">Öğretmen Yorumu</div>
                        <div>@Lesson.TeacherComment</div>
                    </div>
                }
            </div>
            <div class="col-lg-8">
                <h6 class="text-uppercase text-muted small">Günlük Raporlar</h6>
                @if (Lesson.DailyReports.Count == 0)
                {
                    <div class="text-muted">Bu ders için henüz rapor bulunmuyor.</div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var report in Lesson.DailyReports)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fw-semibold">@report.Date.ToString("dd.MM.yyyy")</div>
                                        <div class="small text-muted">
                                            @(report.IsPresent ? "Geldi" : "Gelmedi")
                                            @if (report.DailyGrade.HasValue)
                                            {
                                                <span class="ms-2">| Not: @report.DailyGrade.Value.ToString("0.##")</span>
                                            }
                                        </div>
                                        @if (!report.DailyComment.IsNullOrWhiteSpace())
                                        {
                                            <div class="mt-1">@report.DailyComment</div>
                                        }
                                    </div>
                                    <span class="badge @(report.IsPresent ? "bg-success" : "bg-danger")">
                                        @(report.IsPresent ? "Geldi" : "Gelmedi")
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public StudentLessonDashboardDto Lesson { get; set; } = default!;

    private static string FormatDecimal(decimal? value)
    {
        return value.HasValue ? value.Value.ToString("0.##") : "-";
    }
}
