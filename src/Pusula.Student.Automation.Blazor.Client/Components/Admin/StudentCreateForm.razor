@using Microsoft.AspNetCore.Components.Forms
@using Pusula.Student.Automation.Enums
@using Pusula.Student.Automation.Students

<EditForm Model="@Model" OnValidSubmit="@OnValidSubmitInternal">
    <Microsoft.AspNetCore.Components.Forms.DataAnnotationsValidator />
    <Microsoft.AspNetCore.Components.Forms.ValidationSummary />

    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="alert alert-info">@Message</div>
    }

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Kullanıcı Adı</label>
            <input class="form-control" @bind="Model.UserName" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Parola</label>
            <input class="form-control" type="password" @bind="Model.Password" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Ad</label>
            <input class="form-control" @bind="Model.Name" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Soyad</label>
            <input class="form-control" @bind="Model.Surname" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Cinsiyet</label>
            <select class="form-select" @bind="Model.Gender">
                @foreach (EnumGender gender in Enum.GetValues(typeof(EnumGender)))
                {
                    <option value="@gender">@gender</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Öğrenci No</label>
            <input class="form-control" @bind="Model.StudentNumber" />
        </div>
        <div class="col-md-6">
            <label class="form-label">E-posta</label>
            <input class="form-control" type="email" @bind="Model.Email" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Telefon</label>
            <input class="form-control" @bind="Model.PhoneNumber" />
        </div>
    </div>

    <div class="mt-3 text-end">
        <button class="btn btn-success" type="submit" disabled="@IsSubmitting">Kaydet</button>
    </div>
</EditForm>

@code {
    [Parameter] public StudentCreateWithIdentityDto Model { get; set; } = default!;
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public EventCallback OnValidSubmit { get; set; }

    private Task OnValidSubmitInternal() => OnValidSubmit.InvokeAsync(null);
}
