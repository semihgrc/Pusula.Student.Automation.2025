@using Microsoft.AspNetCore.Components.Forms
@using Pusula.Student.Automation.Enums
@using Pusula.Student.Automation.Teachers

<EditForm Model="@Model" OnValidSubmit="@OnValidSubmitInternal">
    <Microsoft.AspNetCore.Components.Forms.DataAnnotationsValidator />
    <Microsoft.AspNetCore.Components.Forms.ValidationSummary />

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Ad</label>
            <input class="form-control" @bind="Model.Name" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Soyad</label>
            <input class="form-control" @bind="Model.Surname" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Cinsiyet</label>
            <select class="form-select" @bind="Model.Gender">
                @foreach (EnumGender gender in Enum.GetValues(typeof(EnumGender)))
                {
                    <option value="@gender">@gender</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Unvan</label>
            <input class="form-control" @bind="Model.Title" />
        </div>
        <div class="col-md-6">
            <label class="form-label">E-posta</label>
            <input class="form-control" type="email" @bind="Model.Email" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Telefon</label>
            <input class="form-control" @bind="Model.PhoneNumber" />
        </div>
    </div>

    <div class="mt-3 d-flex justify-content-between">
        @if (OnCancel.HasDelegate)
        {
            <button type="button" class="btn btn-outline-secondary" @onclick="OnCancelInternal">İptal</button>
        }
        <button class="btn btn-primary ms-auto" type="submit" disabled="@IsSubmitting">Kaydet</button>
    </div>
</EditForm>

@code {
    [Parameter] public TeacherUpdateDto Model { get; set; } = default!;
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Task OnValidSubmitInternal() => OnValidSubmit.InvokeAsync(null);
    private Task OnCancelInternal() => OnCancel.InvokeAsync(null);
}
