@page "/teacher/management"
@using Microsoft.AspNetCore.Authorization
@using System.Linq
@using Pusula.Student.Automation
@using Pusula.Student.Automation.Authorization
@using Pusula.Student.Automation.Permissions
@using Pusula.Student.Automation.Enums
@using Pusula.Student.Automation.Lessons
@using Pusula.Student.Automation.Students
@using Pusula.Student.Automation.TeacherPortal
@using Volo.Abp
@attribute [Authorize(AutomationPermissions.TeacherPortal)]
@inherits AutomationComponentBase
@inject ITeacherPortalAppService TeacherPortalAppService
@inject ILessonAppService LessonAppService

<PageTitle>Öğretmen Paneli</PageTitle>

<div class="container-fluid py-4">
    @if (!string.IsNullOrWhiteSpace(AlertMessage))
    {
        <div class="alert alert-info">@AlertMessage</div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <div class="fw-bold">Hızlı Öğrenci Oluştur</div>
                    <small>@ProfileText</small>
                </div>
                <div class="card-body">
                    <StudentCreateForm Model="NewStudentModel"
                                       IsSubmitting="IsCreatingStudent"
                                       Message="@StudentFormMessage"
                                       OnValidSubmit="CreateStudentAsync" />
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex flex-column flex-xl-row gap-2 align-items-xl-center">
                    <input class="form-control" placeholder="Ders ara..." @bind="LessonFilter" />
                    <select class="form-select" value="@SelectedStatusValue" @onchange="OnStatusFilterChanged">
                        <option value="">Tüm durumlar</option>
                        @foreach (LessonStatus status in Enum.GetValues(typeof(LessonStatus)))
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                    <div class="form-check ms-xl-3">
                        <input class="form-check-input" type="checkbox" id="mineToggle" @bind="ShowOnlyMine" />
                        <label class="form-check-label" for="mineToggle">Yalnızca derslerim</label>
                    </div>
                    <button class="btn btn-outline-primary ms-xl-auto" @onclick="LoadLessonsAsync" disabled="@IsLoadingLessons">
                        @(IsLoadingLessons ? "Yükleniyor..." : "Dersleri Getir")
                    </button>
                </div>
                <div class="card-body">
                    @if (IsLoadingLessons)
                    {
                        <div class="text-muted">Dersler yükleniyor...</div>
                    }
                    else
                    {
                        <TeacherLessonList Items="Lessons"
                                           SelectedLessonId="SelectedLesson?.Id"
                                           ManagedTeacherId="Profile?.TeacherId"
                                           OnSelect="SelectLessonAsync"
                                           OnStatusChange="ChangeLessonStatusAsync" />
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-bold">Ders Detayı</span>
                        @if (SelectedLesson != null)
                        {
                            <span class="text-muted ms-2">@SelectedLesson.Name</span>
                        }
                    </div>
                    @if (SelectedLesson != null && !CanManageSelectedLesson)
                    {
                        <span class="badge bg-secondary">Bu derste yalnızca görüntüleme yetkiniz var.</span>
                    }
                </div>
                <div class="card-body">
                    <TeacherEnrollmentList Lesson="SelectedLesson"
                                           CanManage="CanManageSelectedLesson"
                                           OnUpdate="UpdateEnrollmentAsync"
                                           OnRemove="HandleRemoveStudentAsync" />

                    @if (SelectedLesson != null && CanManageSelectedLesson)
                    {
                        <div class="mt-4">
                            <h6>Öğrenci Ekle</h6>
                            <div class="input-group mb-2">
                                <input class="form-control"
                                       placeholder="Ad, numara veya e-posta"
                                       @bind="StudentSearchFilter" />
                                <button class="btn btn-outline-primary" @onclick="SearchStudentsAsync" disabled="@IsSearchingStudents">
                                    @(IsSearchingStudents ? "Aranıyor..." : "Ara / Listele")
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="ShowAllStudentsAsync" disabled="@IsSearchingStudents">
                                    Tümünü Göster
                                </button>
                            </div>
                            @if (StudentSearchResults.Count > 0)
                            {
                                <div class="list-group small">
                                    @foreach (var student in StudentSearchResults)
                                    {
                                        <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                                @onclick="() => AddStudentToLessonAsync(student.Id)">
                                            <span>
                                                <strong>@student.Name @student.Surname</strong>
                                                <span class="text-muted ms-1">(@student.StudentNumber)</span>
                                            </span>
                                            <span>@student.Email</span>
                                        </button>
                                    }
                                </div>
                            }
                            else if (!IsSearchingStudents)
                            {
                                <div class="text-muted">Sonuç bulunamadı. Lütfen yeni bir filtre deneyin.</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (SelectedLesson != null && CanManageSelectedLesson)
    {
        <div class="card shadow-sm mt-4">
            <div class="card-header d-flex flex-wrap gap-3 align-items-center">
                <div class="fw-bold">Günlük Rapor</div>
                <input type="date"
                       class="form-control form-control-sm w-auto"
                       value="@SelectedAttendanceDate.ToString("yyyy-MM-dd")"
                       @onchange="OnAttendanceDateChanged" />
                <button class="btn btn-outline-secondary btn-sm" @onclick="LoadAttendanceAsync" disabled="@IsLoadingAttendance">
                    Yenile
                </button>
                <button class="btn btn-outline-success btn-sm ms-auto"
                        @onclick="SaveAttendanceBatchAsync"
                        disabled="@IsSavingAttendance">
                    @(IsSavingAttendance ? "Kaydediliyor..." : "Raporu Kaydet")
                </button>
                <small class="text-muted">Varsayılan not 75, durum "Geldi" olarak gelir.</small>
            </div>
            <div class="card-body">
                @if (IsLoadingAttendance)
                {
                    <div class="text-muted">Rapor verileri yükleniyor...</div>
                }
                else
                {
                    <div class="row g-4">
                        <div class="col-lg-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small text-muted">Kaydedilmiş raporlar</span>
                                <span class="badge bg-light text-dark">@ReportSummaries.Count</span>
                            </div>
                            @if (ReportSummaries.Count == 0)
                            {
                                <div class="text-muted small">Henüz rapor kaydedilmedi.</div>
                            }
                            else
                            {
                                <div class="list-group list-group-flush border rounded">
                                    @foreach (var summary in ReportSummaries)
                                    {
                                        var isSelected = SelectedDailyReport?.Id == summary.Id;
                                        <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(isSelected ? "active" : string.Empty)"
                                                @onclick="() => SelectReportSummaryAsync(summary)">
                                            <span>@summary.Date.ToString("dd.MM.yyyy")</span>
                                            <span class="badge bg-secondary">@summary.StudentCount</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-lg-9">
                            @if (AttendanceEntries.Count == 0)
                            {
                                <div class="alert alert-warning mb-0">
                                    Bu derse ait öğrenci bulunamadı.
                                </div>
                            }
                            else
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    @if (SelectedDailyReport != null)
                                    {
                                        <span class="badge bg-success">Kaydedilmiş rapor</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">Yeni rapor</span>
                                    }
                                    <span class="text-muted small">@SelectedAttendanceDate.ToString("dd.MM.yyyy") tarihinde işlenen ders</span>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle">
                                        <thead>
                                        <tr>
                                            <th>Öğrenci</th>
                                            <th>Durum</th>
                                            <th>Günlük Not</th>
                                            <th>Yorum</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var entry in AttendanceEntries)
                                        {
                                            <tr>
                                                <td>
                                                    <div>@entry.StudentName</div>
                                                    <small class="text-muted">@entry.StudentNumber</small>
                                                </td>
                                                <td style="width:140px;">
                                                    <InputSelect class="form-select form-select-sm" @bind-Value="entry.IsPresent">
                                                        <option value="true">Geldi</option>
                                                        <option value="false">Gelmedi</option>
                                                    </InputSelect>
                                                </td>
                                                <td style="width:140px;">
                                                    <input type="number"
                                                           step="0.01"
                                                           class="form-control form-control-sm"
                                                           @bind="entry.DailyGrade" />
                                                </td>
                                                <td>
                                                    <textarea class="form-control form-control-sm" rows="1" @bind="entry.DailyComment"></textarea>
                                                </td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private TeacherPortalProfileDto? Profile;
    private string ProfileText => Profile == null ? "Profil yükleniyor..." : $"{Profile.Name} {Profile.Surname}";

    private List<LessonDto> Lessons { get; set; } = new();
    private LessonDto? SelectedLesson;
    private bool ShowOnlyMine = true;
    private string? LessonFilter;
    private LessonStatus? StatusFilter;
    private bool IsLoadingLessons;

    private StudentCreateWithIdentityDto NewStudentModel = new();
    private bool IsCreatingStudent;
    private string? StudentFormMessage;

    private string? StudentSearchFilter;
    private List<StudentLookupDto> StudentSearchResults { get; set; } = new();
    private bool IsSearchingStudents;

    private DateTime SelectedAttendanceDate = DateTime.Today;
    private List<LessonAttendanceEditModel> AttendanceEntries { get; set; } = new();
    private List<LessonDailyReportSummaryDto> ReportSummaries { get; set; } = new();
    private LessonDailyReportDto? SelectedDailyReport;
    private bool IsLoadingAttendance;
    private bool IsSavingAttendance;

    private string? AlertMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProfileAsync();
        ResetStudentForm();
        await LoadLessonsAsync();
        await SearchStudentsAsync();
    }

    private async Task LoadProfileAsync()
    {
        Profile = await TeacherPortalAppService.GetProfileAsync();
    }

    private void ResetStudentForm()
    {
        NewStudentModel = new StudentCreateWithIdentityDto
        {
            Gender = EnumGender.Male
        };
        StudentFormMessage = null;
    }

    private async Task LoadLessonsAsync()
    {
        if (Profile == null)
        {
            return;
        }

        IsLoadingLessons = true;
        try
        {
            var request = new LessonListRequestDto
            {
                Filter = LessonFilter,
                Status = StatusFilter,
                MaxResultCount = 500
            };

            if (ShowOnlyMine)
            {
                request.TeacherId = Profile.TeacherId;
            }

            var result = await LessonAppService.GetListAsync(request);
            Lessons = result.Items.ToList();

            if (SelectedLesson != null)
            {
                var stillExists = Lessons.FirstOrDefault(l => l.Id == SelectedLesson.Id);
                SelectedLesson = stillExists;
            }
        }
        finally
        {
            IsLoadingLessons = false;
        }
    }

    private async Task SelectLessonAsync(Guid lessonId)
    {
        SelectedLesson = await LessonAppService.GetAsync(lessonId);
        SelectedAttendanceDate = DateTime.Today;
        await LoadDailyReportSummariesAsync();
        await LoadAttendanceAsync();
    }

    private async Task ChangeLessonStatusAsync((Guid LessonId, LessonStatus Status, string ConcurrencyStamp) payload)
    {
        if (!CanManageLesson(payload.LessonId))
        {
            SetAlert("Bu dersin durumunu değiştirme yetkiniz yok.");
            return;
        }

        await LessonAppService.ChangeStatusAsync(payload.LessonId, new LessonStatusUpdateDto
        {
            Status = payload.Status,
            ConcurrencyStamp = payload.ConcurrencyStamp
        });

        await LoadLessonsAsync();
        if (SelectedLesson?.Id == payload.LessonId)
        {
            await RefreshSelectedLessonAsync();
            await LoadDailyReportSummariesAsync();
            await LoadAttendanceAsync();
        }
    }

    private async Task RefreshSelectedLessonAsync()
    {
        if (SelectedLesson == null)
        {
            return;
        }

        SelectedLesson = await LessonAppService.GetAsync(SelectedLesson.Id);
    }

    private async Task CreateStudentAsync()
    {
        IsCreatingStudent = true;
        try
        {
            await TeacherPortalAppService.CreateStudentAsync(NewStudentModel);
            StudentFormMessage = "Öğrenci başarıyla oluşturuldu.";
            ResetStudentForm();
            await SearchStudentsAsync();
        }
        catch (Exception ex)
        {
            StudentFormMessage = ex.Message;
        }
        finally
        {
            IsCreatingStudent = false;
        }
    }

    private async Task UpdateEnrollmentAsync((Guid LessonId, Guid StudentId, LessonEnrollmentUpdateDto Input) payload)
    {
        if (!CanManageSelectedLesson || SelectedLesson == null)
        {
            SetAlert("Bu derste değişiklik yapma yetkiniz yok.");
            return;
        }

        await LessonAppService.UpdateEnrollmentAsync(payload.LessonId, payload.StudentId, payload.Input);
        await RefreshSelectedLessonAsync();
        await LoadAttendanceAsync();
    }

    private async Task HandleRemoveStudentAsync(Guid studentId)
    {
        if (!CanManageSelectedLesson || SelectedLesson == null)
        {
            SetAlert("Bu derste değişiklik yapma yetkiniz yok.");
            return;
        }

        await LessonAppService.RemoveStudentAsync(SelectedLesson.Id, studentId);
        await RefreshSelectedLessonAsync();
        await LoadAttendanceAsync();
        await SearchStudentsAsync();
    }

    private async Task SearchStudentsAsync()
    {
        IsSearchingStudents = true;
        try
        {
            StudentSearchResults = await TeacherPortalAppService.SearchStudentsAsync(StudentSearchFilter);
            FilterStudentSearchResults();
        }
        finally
        {
            IsSearchingStudents = false;
        }
    }

    private async Task ShowAllStudentsAsync()
    {
        StudentSearchFilter = string.Empty;
        await SearchStudentsAsync();
    }

    private async Task AddStudentToLessonAsync(Guid studentId)
    {
        if (!CanManageSelectedLesson || SelectedLesson == null)
        {
            SetAlert("Bu derse öğrenci ekleme yetkiniz yok.");
            return;
        }

        await LessonAppService.AddStudentAsync(new LessonEnrollmentCreateDto
        {
            LessonId = SelectedLesson.Id,
            StudentId = studentId
        });

        await RefreshSelectedLessonAsync();
        await LoadDailyReportSummariesAsync();
        await LoadAttendanceAsync();
        await SearchStudentsAsync();
        SetAlert("Öğrenci derse eklendi.");
    }

    private async Task LoadDailyReportSummariesAsync()
    {
        ReportSummaries.Clear();

        if (!CanManageSelectedLesson || SelectedLesson == null)
        {
            return;
        }

        ReportSummaries = await LessonAppService.GetDailyReportsAsync(SelectedLesson.Id);
    }

    private async Task LoadAttendanceAsync()
    {
        AttendanceEntries.Clear();

        if (!CanManageSelectedLesson || SelectedLesson == null)
        {
            return;
        }

        IsLoadingAttendance = true;
        try
        {
            LessonDailyReportDto? report = null;
            try
            {
                report = await LessonAppService.GetDailyReportAsync(SelectedLesson.Id, SelectedAttendanceDate);
            }
            catch (BusinessException ex) when (ex.Code == AutomationDomainErrorCodes.LessonDailyReportNotFound)
            {
                report = null;
            }

            if (report != null)
            {
                SelectedDailyReport = report;
                AttendanceEntries = report.Entries
                    .Select(entry => new LessonAttendanceEditModel
                    {
                        EntryId = entry.Id,
                        StudentId = entry.StudentId,
                        StudentName = entry.StudentName,
                        StudentNumber = entry.StudentNumber,
                        IsPresent = entry.IsPresent,
                        DailyGrade = entry.DailyGrade,
                        DailyComment = entry.DailyComment
                    })
                    .OrderBy(e => e.StudentName)
                    .ToList();
            }
            else
            {
                SelectedDailyReport = null;
                AttendanceEntries = SelectedLesson.Enrollments
                    .Select(e => new LessonAttendanceEditModel
                    {
                        StudentId = e.StudentId,
                        StudentName = e.StudentName,
                        StudentNumber = e.StudentNumber,
                        IsPresent = true,
                        DailyGrade = 75m
                    })
                    .OrderBy(e => e.StudentName)
                    .ToList();
            }
        }
        finally
        {
            IsLoadingAttendance = false;
        }
    }

    private async Task SaveAttendanceBatchAsync()
    {
        if (!CanManageSelectedLesson || SelectedLesson == null)
        {
            SetAlert("Bu ders için kayıt oluşturma yetkiniz yok.");
            return;
        }

        if (AttendanceEntries.Count == 0)
        {
            SetAlert("Kaydedilecek öğrenci bulunamadı.");
            return;
        }

        IsSavingAttendance = true;
        try
        {
            var payload = new LessonDailyReportSaveDto
            {
                ReportId = SelectedDailyReport?.Id,
                LessonId = SelectedLesson.Id,
                Date = SelectedAttendanceDate,
                Entries = AttendanceEntries
                    .Select(entry => new LessonDailyReportEntrySaveDto
                    {
                        EntryId = entry.EntryId,
                        StudentId = entry.StudentId,
                        IsPresent = entry.IsPresent,
                        DailyGrade = entry.DailyGrade,
                        DailyComment = entry.DailyComment
                    })
                    .ToList()
            };

            var result = await LessonAppService.SaveDailyReportAsync(payload);
            SelectedDailyReport = result;
            SelectedAttendanceDate = result.Date.Date;
            await LoadDailyReportSummariesAsync();
            UpdateSummaries(result);
            await LoadAttendanceAsync();
            SetAlert("Rapor kaydedildi.");
        }
        catch (BusinessException ex)
        {
            if (ex.Code == AutomationDomainErrorCodes.LessonDailyReportAlreadyExists)
            {
                SetAlert("Bu tarih için daha önce rapor kaydedilmiş. Kaydedilen raporlar listesinden seçebilirsiniz.");
                await LoadDailyReportSummariesAsync();
            }
            else
            {
                SetAlert(ex.Message);
            }
        }
        finally
        {
            IsSavingAttendance = false;
        }
    }

    private async Task OnAttendanceDateChanged(ChangeEventArgs args)
    {
        if (DateTime.TryParse(args.Value?.ToString(), out var date))
        {
            SelectedAttendanceDate = date.Date;
            await LoadAttendanceAsync();
        }
    }

    private async Task SelectReportSummaryAsync(LessonDailyReportSummaryDto summary)
    {
        SelectedAttendanceDate = summary.Date.Date;
        await LoadAttendanceAsync();
    }

    private bool CanManageLesson(Guid lessonId)
    {
        return Profile != null && Lessons.FirstOrDefault(l => l.Id == lessonId)?.TeacherId == Profile.TeacherId;
    }

    private bool CanManageSelectedLesson => SelectedLesson != null && Profile != null && SelectedLesson.TeacherId == Profile.TeacherId;

    private string? SelectedStatusValue => StatusFilter?.ToString();

    private void OnStatusFilterChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(value))
        {
            StatusFilter = null;
        }
        else if (Enum.TryParse<LessonStatus>(value, out var status))
        {
            StatusFilter = status;
        }
    }

    private void SetAlert(string? message)
    {
        AlertMessage = message;
    }

    private void FilterStudentSearchResults()
    {
        if (StudentSearchResults.Count == 0 || SelectedLesson?.Enrollments == null)
        {
            return;
        }

        var enrolledIds = SelectedLesson.Enrollments.Select(e => e.StudentId).ToHashSet();
        StudentSearchResults = StudentSearchResults
            .Where(student => !enrolledIds.Contains(student.Id))
            .ToList();
    }

    private void UpdateSummaries(LessonDailyReportDto report)
    {
        var summary = ReportSummaries.FirstOrDefault(x => x.Id == report.Id);
        if (summary == null)
        {
            summary = new LessonDailyReportSummaryDto { Id = report.Id };
            ReportSummaries.Add(summary);
        }

        summary.Date = report.Date;
        summary.StudentCount = report.Entries.Count;
        ReportSummaries = ReportSummaries
            .OrderByDescending(s => s.Date)
            .ToList();
    }

    private class LessonAttendanceEditModel
    {
        public Guid? EntryId { get; set; }
        public Guid StudentId { get; set; }
        public string StudentName { get; set; } = string.Empty;
        public string StudentNumber { get; set; } = string.Empty;
        public bool IsPresent { get; set; } = true;
        public decimal? DailyGrade { get; set; } = 75m;
        public string? DailyComment { get; set; }
    }
}
