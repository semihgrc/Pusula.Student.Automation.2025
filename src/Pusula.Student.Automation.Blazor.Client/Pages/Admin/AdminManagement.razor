@page "/admin/management"
@using System.Linq
@using Microsoft.AspNetCore.Authorization
@using Pusula.Student.Automation.Permissions
@using Pusula.Student.Automation.AdminManagement
@using Pusula.Student.Automation.LessonEnrollments
@using Pusula.Student.Automation.Lessons
@using Pusula.Student.Automation.Students
@using Pusula.Student.Automation.Teachers
@attribute [Authorize(AutomationPermissions.AdminManagement)]
@inherits AutomationComponentBase

<PageTitle>Yönetim Paneli</PageTitle>

<div class="container-fluid py-4">
    <div class="row g-4">
        <div class="col-12 col-xl-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">Yeni Öğretmen</div>
                <div class="card-body">
                    <TeacherCreateForm Model="NewTeacher"
                                       IsSubmitting="IsSubmittingTeacher"
                                       Message="@TeacherFormMessage"
                                       OnValidSubmit="CreateTeacherAsync" />
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white">Yeni Öğrenci</div>
                <div class="card-body">
                    <StudentCreateForm Model="NewStudent"
                                       IsSubmitting="IsSubmittingStudent"
                                       Message="@StudentFormMessage"
                                       OnValidSubmit="CreateStudentAsync" />
                </div>
            </div>
        </div>
    </div>

    <AdminUserSearch />

    @if (TeacherEditInput != null || StudentEditInput != null)
    {
        <div class="row g-4 mt-1">
            @if (TeacherEditInput != null)
            {
                <div class="col-12 col-xl-6">
                    <div class="card shadow-sm h-100 border-primary">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <span>Öğretmen Güncelle</span>
                            <button class="btn btn-sm btn-link" @onclick="CancelTeacherEdit">Kapat</button>
                        </div>
                        <div class="card-body">
                            <TeacherEditForm Model="TeacherEditInput"
                                             IsSubmitting="IsUpdatingTeacher"
                                             OnValidSubmit="UpdateTeacherAsync"
                                             OnCancel="CancelTeacherEdit" />
                        </div>
                    </div>
                </div>
            }

            @if (StudentEditInput != null)
            {
                <div class="col-12 col-xl-6">
                    <div class="card shadow-sm h-100 border-success">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <span>Öğrenci Güncelle</span>
                            <button class="btn btn-sm btn-link" @onclick="CancelStudentEdit">Kapat</button>
                        </div>
                        <div class="card-body">
                            <StudentEditForm Model="StudentEditInput"
                                             IsSubmitting="IsUpdatingStudent"
                                             OnValidSubmit="UpdateStudentAsync"
                                             OnCancel="CancelStudentEdit" />
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="row g-4 mt-1">
        <div class="col-12 col-xl-6">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Öğretmenler</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadTeachersAsync">Yenile</button>
                </div>
                <div class="card-body p-0">
                    <TeacherList Items="TeacherItems"
                                 OnShowDetails="ShowTeacherDetailsAsync"
                                 OnEdit="BeginEditTeacherAsync"
                                 OnDelete="DeleteTeacherAsync" />
                </div>
            </div>

            <TeacherDetails Teacher="SelectedTeacher"
                            Lessons="TeacherLessons"
                            Students="StudentItems"
                            OnCreateLesson="HandleCreateLessonAsync"
                            OnDeleteLesson="DeleteLessonAsync"
                            OnUpdateLesson="HandleUpdateLessonAsync"
                            OnAddStudent="HandleAddStudentAsync"
                            OnRemoveStudent="HandleRemoveStudentAsync" />
        </div>

        <div class="col-12 col-xl-6">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Öğrenciler</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadStudentsAsync">Yenile</button>
                </div>
                <div class="card-body p-0">
                    <StudentTable Items="StudentItems"
                                  OnEdit="BeginEditStudentAsync"
                                  OnDelete="DeleteStudentAsync" />
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private ITeacherAppService TeacherAppService { get; set; } = default!;
    [Inject] private IStudentAppService StudentAppService { get; set; } = default!;
    [Inject] private ILessonAppService LessonAppService { get; set; } = default!;

    private TeacherCreateWithIdentityDto NewTeacher { get; set; } = new();
    private StudentCreateWithIdentityDto NewStudent { get; set; } = new();

    private List<TeacherDto> TeacherItems { get; set; } = new();
    private List<StudentDto> StudentItems { get; set; } = new();
    private List<LessonDto> TeacherLessons { get; set; } = new();

    private TeacherDto? SelectedTeacher { get; set; }

    private bool IsSubmittingTeacher;
    private bool IsSubmittingStudent;
    private string? TeacherFormMessage;
    private string? StudentFormMessage;

    private TeacherUpdateDto? TeacherEditInput;
    private Guid? EditingTeacherId;
    private bool IsUpdatingTeacher;

    private StudentUpdateDto? StudentEditInput;
    private Guid? EditingStudentId;
    private bool IsUpdatingStudent;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAllAsync();
    }

    private async Task ReloadAllAsync()
    {
        await Task.WhenAll(LoadTeachersAsync(), LoadStudentsAsync());
    }

    private async Task LoadTeachersAsync()
    {
        var result = await TeacherAppService.GetListAsync(new TeacherListRequestDto
        {
            MaxResultCount = 1000
        });

        TeacherItems = result.Items.ToList();
        if (SelectedTeacher != null)
        {
            var exists = TeacherItems.FirstOrDefault(t => t.Id == SelectedTeacher.Id);
            if (exists != null)
            {
                await ShowTeacherDetailsAsync(exists.Id);
            }
            else
            {
                SelectedTeacher = null;
                TeacherLessons.Clear();
            }
        }
        StateHasChanged();
    }

    private async Task LoadStudentsAsync()
    {
        var result = await StudentAppService.GetListAsync(new StudentListRequestDto
        {
            MaxResultCount = 1000
        });
        StudentItems = result.Items.ToList();
        StateHasChanged();
    }

    private async Task CreateTeacherAsync()
    {
        IsSubmittingTeacher = true;
        TeacherFormMessage = null;
        try
        {
            await TeacherAppService.CreateWithIdentityAsync(NewTeacher);
            TeacherFormMessage = "Öğretmen kaydedildi.";
            NewTeacher = new TeacherCreateWithIdentityDto();
            await LoadTeachersAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            IsSubmittingTeacher = false;
        }
    }

    private async Task CreateStudentAsync()
    {
        IsSubmittingStudent = true;
        StudentFormMessage = null;
        try
        {
            await StudentAppService.CreateWithIdentityAsync(NewStudent);
            StudentFormMessage = "Öğrenci kaydedildi.";
            NewStudent = new StudentCreateWithIdentityDto();
            await LoadStudentsAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            IsSubmittingStudent = false;
        }
    }

    private async Task BeginEditTeacherAsync(Guid teacherId)
    {
        var teacher = await TeacherAppService.GetAsync(teacherId);
        EditingTeacherId = teacherId;
        TeacherEditInput = new TeacherUpdateDto
        {
            IdentityUserId = teacher.IdentityUserId,
            Name = teacher.Name,
            Surname = teacher.Surname,
            Gender = teacher.Gender,
            Title = teacher.Title,
            Email = teacher.Email,
            PhoneNumber = teacher.PhoneNumber,
            ConcurrencyStamp = teacher.ConcurrencyStamp
        };
    }

    private async Task UpdateTeacherAsync()
    {
        if (EditingTeacherId is null || TeacherEditInput is null)
        {
            return;
        }

        IsUpdatingTeacher = true;
        try
        {
            await TeacherAppService.UpdateAsync(EditingTeacherId.Value, TeacherEditInput);
            await LoadTeachersAsync();
            if (SelectedTeacher?.Id == EditingTeacherId.Value)
            {
                await ShowTeacherDetailsAsync(SelectedTeacher.Id);
            }
            CancelTeacherEdit();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            IsUpdatingTeacher = false;
        }
    }

    private void CancelTeacherEdit()
    {
        TeacherEditInput = null;
        EditingTeacherId = null;
    }

    private async Task BeginEditStudentAsync(Guid studentId)
    {
        var student = await StudentAppService.GetAsync(studentId);
        EditingStudentId = studentId;
        StudentEditInput = new StudentUpdateDto
        {
            IdentityUserId = student.IdentityUserId,
            Name = student.Name,
            Surname = student.Surname,
            Gender = student.Gender,
            Email = student.Email,
            PhoneNumber = student.PhoneNumber,
            StudentNumber = student.StudentNumber,
            ConcurrencyStamp = student.ConcurrencyStamp
        };
    }

    private async Task UpdateStudentAsync()
    {
        if (EditingStudentId is null || StudentEditInput is null)
        {
            return;
        }

        IsUpdatingStudent = true;
        try
        {
            await StudentAppService.UpdateAsync(EditingStudentId.Value, StudentEditInput);
            await LoadStudentsAsync();
            CancelStudentEdit();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            IsUpdatingStudent = false;
        }
    }

    private void CancelStudentEdit()
    {
        StudentEditInput = null;
        EditingStudentId = null;
    }

    private async Task DeleteTeacherAsync(Guid teacherId)
    {
        if (!await ConfirmAsync("Öğretmeni silmek istediğinize emin misiniz?")) return;
        await TeacherAppService.DeleteAsync(teacherId);
        await LoadTeachersAsync();
    }

    private async Task DeleteStudentAsync(Guid studentId)
    {
        if (!await ConfirmAsync("Öğrenciyi silmek istediğinize emin misiniz?")) return;
        await StudentAppService.DeleteAsync(studentId);
        await LoadStudentsAsync();
    }

    private async Task ShowTeacherDetailsAsync(Guid teacherId)
    {
        SelectedTeacher = await TeacherAppService.GetAsync(teacherId);
        var lessonsResult = await LessonAppService.GetListAsync(new LessonListRequestDto
        {
            TeacherId = teacherId,
            MaxResultCount = 1000
        });
        TeacherLessons = lessonsResult.Items.ToList();
    }

    private async Task HandleCreateLessonAsync(LessonCreateDto input)
    {
        if (SelectedTeacher == null)
        {
            return;
        }

        await LessonAppService.CreateAsync(input);
        await ShowTeacherDetailsAsync(input.TeacherId);
    }

    private async Task HandleAddStudentAsync((Guid LessonId, Guid StudentId) payload)
    {
        var input = new LessonEnrollmentCreateDto
        {
            LessonId = payload.LessonId,
            StudentId = payload.StudentId
        };

        await LessonAppService.AddStudentAsync(input);
        if (SelectedTeacher != null)
        {
            await ShowTeacherDetailsAsync(SelectedTeacher.Id);
        }
    }

    private async Task HandleUpdateLessonAsync((Guid LessonId, LessonUpdateDto Input) payload)
    {
        await LessonAppService.UpdateAsync(payload.LessonId, payload.Input);
        if (SelectedTeacher != null)
        {
            await ShowTeacherDetailsAsync(SelectedTeacher.Id);
        }
    }

    private async Task HandleRemoveStudentAsync((Guid LessonId, Guid StudentId) payload)
    {
        await LessonAppService.RemoveStudentAsync(payload.LessonId, payload.StudentId);
        if (SelectedTeacher != null)
        {
            await ShowTeacherDetailsAsync(SelectedTeacher.Id);
        }
    }

    private async Task DeleteLessonAsync(Guid lessonId)
    {
        if (!await ConfirmAsync("Ders silinecek, emin misiniz?")) return;
        await LessonAppService.DeleteAsync(lessonId);
        if (SelectedTeacher != null)
        {
            await ShowTeacherDetailsAsync(SelectedTeacher.Id);
        }
    }

    private Task<bool> ConfirmAsync(string message)
    {
        return Task.FromResult(true);
    }
}
