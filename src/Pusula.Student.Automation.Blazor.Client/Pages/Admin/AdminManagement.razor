@page "/admin/management"
@using Microsoft.AspNetCore.Authorization
@using Pusula.Student.Automation.Authorization
@using Pusula.Student.Automation.Enums
@using Pusula.Student.Automation.Teachers
@using Pusula.Student.Automation.Students
@using Pusula.Student.Automation.LessonEnrollments
@using Pusula.Student.Automation.Lessons
@attribute [Authorize(Roles = AutomationRoleNames.Admin)]
@inherits AutomationComponentBase

<PageTitle>Yönetim Paneli</PageTitle>

<div class="container-fluid py-4">
    <div class="row g-4">
        <div class="col-12 col-xl-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    Yeni Öğretmen
                </div>
                <div class="card-body">
                    <EditForm Model="@NewTeacher" OnValidSubmit="@CreateTeacherAsync">
                        <Microsoft.AspNetCore.Components.Forms.DataAnnotationsValidator />
                        <Microsoft.AspNetCore.Components.Forms.ValidationSummary />
                        @if (!string.IsNullOrEmpty(TeacherFormMessage))
                        {
                            <div class="alert alert-info">@TeacherFormMessage</div>
                        }
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Kullanıcı Adı</label>
                                <input class="form-control" @bind="NewTeacher.UserName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Parola</label>
                                <input class="form-control" type="password" @bind="NewTeacher.Password" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Ad</label>
                                <input class="form-control" @bind="NewTeacher.Name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Soyad</label>
                                <input class="form-control" @bind="NewTeacher.Surname" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Cinsiyet</label>
                                <select class="form-select" @bind="NewTeacher.Gender">
                                    @foreach (EnumGender gender in Enum.GetValues(typeof(EnumGender)))
                                    {
                                        <option value="@gender">@gender</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Unvan</label>
                                <input class="form-control" @bind="NewTeacher.Title" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">E-posta</label>
                                <input class="form-control" type="email" @bind="NewTeacher.Email" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Telefon</label>
                                <input class="form-control" @bind="NewTeacher.PhoneNumber" />
                            </div>
                        </div>
                        <div class="mt-3 text-end">
                            <button class="btn btn-primary" type="submit" disabled="@IsSubmittingTeacher">Kaydet</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    Yeni Öğrenci
                </div>
                <div class="card-body">
                    <EditForm Model="@NewStudent" OnValidSubmit="@CreateStudentAsync">
                        <Microsoft.AspNetCore.Components.Forms.DataAnnotationsValidator />
                        <Microsoft.AspNetCore.Components.Forms.ValidationSummary />
                        @if (!string.IsNullOrEmpty(StudentFormMessage))
                        {
                            <div class="alert alert-info">@StudentFormMessage</div>
                        }
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Kullanıcı Adı</label>
                                <input class="form-control" @bind="NewStudent.UserName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Parola</label>
                                <input class="form-control" type="password" @bind="NewStudent.Password" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Ad</label>
                                <input class="form-control" @bind="NewStudent.Name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Soyad</label>
                                <input class="form-control" @bind="NewStudent.Surname" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Cinsiyet</label>
                                <select class="form-select" @bind="NewStudent.Gender">
                                    @foreach (EnumGender gender in Enum.GetValues(typeof(EnumGender)))
                                    {
                                        <option value="@gender">@gender</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Öğrenci No</label>
                                <input class="form-control" @bind="NewStudent.StudentNumber" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">E-posta</label>
                                <input class="form-control" type="email" @bind="NewStudent.Email" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Telefon</label>
                                <input class="form-control" @bind="NewStudent.PhoneNumber" />
                            </div>
                        </div>
                        <div class="mt-3 text-end">
                            <button class="btn btn-success" type="submit" disabled="@IsSubmittingStudent">Kaydet</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-12 col-xl-6">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Öğretmenler</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadTeachersAsync">Yenile</button>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped mb-0">
                        <thead>
                        <tr>
                            <th>Ad Soyad</th>
                            <th>E-Posta</th>
                            <th>Telefon</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (TeacherItems.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted">Kayıt yok</td></tr>
                        }
                        else
                        {
                            @foreach (var teacher in TeacherItems)
                            {
                                <tr>
                                    <td>@teacher.Name @teacher.Surname</td>
                                    <td>@teacher.Email</td>
                                    <td>@teacher.PhoneNumber</td>
                                    <td class="text-end">
                                        <button class="btn btn-link btn-sm" @onclick="() => ShowTeacherDetailsAsync(teacher.Id)">Detay</button>
                                        <button class="btn btn-link btn-sm text-danger" @onclick="() => DeleteTeacherAsync(teacher.Id)">Sil</button>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (SelectedTeacher != null)
            {
                <div class="card shadow-sm mt-4">
                    <div class="card-header bg-light">
                        <strong>@SelectedTeacher.Name @SelectedTeacher.Surname</strong> - Dersleri
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <h6>Yeni Ders</h6>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <input class="form-control" placeholder="Ders adı" @bind="NewLesson.Name" />
                                </div>
                                <div class="col-md-6">
                                    <input class="form-control" placeholder="Açıklama" @bind="NewLesson.Description" />
                                </div>
                                <div class="col-12 text-end">
                                    <button class="btn btn-sm btn-primary" @onclick="CreateLessonAsync">Ders Ekle</button>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <thead>
                                <tr>
                                    <th>Ders</th>
                                    <th>Durum</th>
                                    <th>Öğrenciler</th>
                                    <th style="width: 220px;">Öğrenci Ekle</th>
                                    <th></th>
                                </tr>
                                </thead>
                                <tbody>
                                @if (TeacherLessons.Count == 0)
                                {
                                    <tr><td colspan="5" class="text-center text-muted">Ders yok</td></tr>
                                }
                                else
                                {
                                    @foreach (var lesson in TeacherLessons)
                                    {
                                        <tr>
                                            <td>@lesson.Name</td>
                                            <td>@lesson.Status</td>
                                            <td>
                                                @if (lesson.Enrollments?.Count > 0)
                                                {
                                                    <ul class="mb-0">
                                                        @foreach (var enrollment in lesson.Enrollments)
                                                        {
                                                            <li>
                                                                @enrollment.StudentName - Not: @(enrollment.Grade?.ToString("0.##") ?? "-") (Devamsızlık: @enrollment.AbsenceCount)
                                                                <button class="btn btn-link btn-sm text-danger" @onclick="() => RemoveStudentFromLessonAsync(lesson.Id, enrollment.StudentId)">Sil</button>
                                                            </li>
                                                        }
                                                    </ul>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Öğrenci yok</span>
                                                }
                                            </td>
                                            <td>
                                                <select class="form-select form-select-sm" @onchange="e => OnLessonStudentSelectChanged(lesson.Id, e.Value?.ToString())">
                                                    <option value="">Öğrenci seç</option>
                                                    @foreach (var student in StudentItems)
                                                    {
                                                        <option value="@student.Id">@student.Name @student.Surname</option>
                                                    }
                                                </select>
                                                <button class="btn btn-outline-secondary btn-sm mt-2" @onclick="() => AddStudentToLessonAsync(lesson.Id)">Ekle</button>
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-link btn-sm text-danger" @onclick="() => DeleteLessonAsync(lesson.Id)">Dersi Sil</button>
                                            </td>
                                        </tr>
                                    }
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col-12 col-xl-6">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Öğrenciler</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadStudentsAsync">Yenile</button>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped mb-0">
                        <thead>
                        <tr>
                            <th>Ad Soyad</th>
                            <th>E-Posta</th>
                            <th>Öğrenci No</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (StudentItems.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted">Kayıt yok</td></tr>
                        }
                        else
                        {
                            @foreach (var student in StudentItems)
                            {
                                <tr>
                                    <td>@student.Name @student.Surname</td>
                                    <td>@student.Email</td>
                                    <td>@student.StudentNumber</td>
                                    <td class="text-end">
                                        <button class="btn btn-link btn-sm text-danger" @onclick="() => DeleteStudentAsync(student.Id)">Sil</button>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private ITeacherAppService TeacherAppService { get; set; } = default!;
    [Inject] private IStudentAppService StudentAppService { get; set; } = default!;
    [Inject] private ILessonAppService LessonAppService { get; set; } = default!;

    private TeacherCreateWithIdentityDto NewTeacher { get; set; } = new();
    private StudentCreateWithIdentityDto NewStudent { get; set; } = new();
    private LessonCreateDto NewLesson { get; set; } = new();

    private List<TeacherDto> TeacherItems { get; set; } = new();
    private List<StudentDto> StudentItems { get; set; } = new();
    private List<LessonDto> TeacherLessons { get; set; } = new();

    private TeacherDto? SelectedTeacher { get; set; }

    private readonly Dictionary<Guid, Guid?> _lessonStudentSelections = new();

    private bool IsSubmittingTeacher;
    private bool IsSubmittingStudent;
    private string? TeacherFormMessage;
    private string? StudentFormMessage;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAllAsync();
    }

    private async Task ReloadAllAsync()
    {
        await Task.WhenAll(LoadTeachersAsync(), LoadStudentsAsync());
    }

    private async Task LoadTeachersAsync()
    {
        var result = await TeacherAppService.GetListAsync(new TeacherListRequestDto
        {
            MaxResultCount = 1000
        });

        TeacherItems = result.Items.ToList();
        if (SelectedTeacher != null)
        {
            var exists = TeacherItems.FirstOrDefault(t => t.Id == SelectedTeacher.Id);
            if (exists != null)
            {
                await ShowTeacherDetailsAsync(exists.Id);
            }
            else
            {
                SelectedTeacher = null;
                TeacherLessons.Clear();
            }
        }
        StateHasChanged();
    }

    private async Task LoadStudentsAsync()
    {
        var result = await StudentAppService.GetListAsync(new StudentListRequestDto
        {
            MaxResultCount = 1000
        });
        StudentItems = result.Items.ToList();
        StateHasChanged();
    }

    private async Task CreateTeacherAsync()
    {
        IsSubmittingTeacher = true;
        TeacherFormMessage = null;
        try
        {
            await TeacherAppService.CreateWithIdentityAsync(NewTeacher);
            TeacherFormMessage = "Öğretmen kaydedildi.";
            NewTeacher = new TeacherCreateWithIdentityDto();
            await LoadTeachersAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            IsSubmittingTeacher = false;
        }
    }

    private async Task CreateStudentAsync()
    {
        IsSubmittingStudent = true;
        StudentFormMessage = null;
        try
        {
            await StudentAppService.CreateWithIdentityAsync(NewStudent);
            StudentFormMessage = "Öğrenci kaydedildi.";
            NewStudent = new StudentCreateWithIdentityDto();
            await LoadStudentsAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            IsSubmittingStudent = false;
        }
    }

    private async Task DeleteTeacherAsync(Guid teacherId)
    {
        if (!await ConfirmAsync("Öğretmeni silmek istediğinize emin misiniz?")) return;
        await TeacherAppService.DeleteAsync(teacherId);
        await LoadTeachersAsync();
    }

    private async Task DeleteStudentAsync(Guid studentId)
    {
        if (!await ConfirmAsync("Öğrenciyi silmek istediğinize emin misiniz?")) return;
        await StudentAppService.DeleteAsync(studentId);
        await LoadStudentsAsync();
    }

    private async Task ShowTeacherDetailsAsync(Guid teacherId)
    {
        SelectedTeacher = await TeacherAppService.GetAsync(teacherId);
        var lessonsResult = await LessonAppService.GetListAsync(new LessonListRequestDto
        {
            TeacherId = teacherId,
            MaxResultCount = 1000
        });
        TeacherLessons = lessonsResult.Items.ToList();
        foreach (var lesson in TeacherLessons)
        {
            if (!_lessonStudentSelections.ContainsKey(lesson.Id))
            {
                _lessonStudentSelections[lesson.Id] = null;
            }
        }
    }

    private async Task CreateLessonAsync()
    {
        if (SelectedTeacher == null || string.IsNullOrWhiteSpace(NewLesson.Name))
        {
            return;
        }

        NewLesson.TeacherId = SelectedTeacher.Id;
        await LessonAppService.CreateAsync(NewLesson);
        NewLesson = new LessonCreateDto();
        await ShowTeacherDetailsAsync(SelectedTeacher.Id);
    }

    private void OnLessonStudentSelectChanged(Guid lessonId, string? value)
    {
        if (Guid.TryParse(value, out var parsed))
        {
            _lessonStudentSelections[lessonId] = parsed;
        }
        else
        {
            _lessonStudentSelections[lessonId] = null;
        }
    }

    private async Task AddStudentToLessonAsync(Guid lessonId)
    {
        if (!_lessonStudentSelections.TryGetValue(lessonId, out var studentId) || studentId is null)
        {
            await HandleErrorAsync(new ApplicationException("Lütfen öğrenci seçiniz."));
            return;
        }

        var input = new LessonEnrollmentCreateDto
        {
            LessonId = lessonId,
            StudentId = studentId.Value
        };

        await LessonAppService.AddStudentAsync(input);
        _lessonStudentSelections[lessonId] = null;
        if (SelectedTeacher != null)
        {
            await ShowTeacherDetailsAsync(SelectedTeacher.Id);
        }
    }

    private async Task RemoveStudentFromLessonAsync(Guid lessonId, Guid studentId)
    {
        await LessonAppService.RemoveStudentAsync(lessonId, studentId);
        if (SelectedTeacher != null)
        {
            await ShowTeacherDetailsAsync(SelectedTeacher.Id);
        }
    }

    private async Task DeleteLessonAsync(Guid lessonId)
    {
        if (!await ConfirmAsync("Ders silinecek, emin misiniz?")) return;
        await LessonAppService.DeleteAsync(lessonId);
        if (SelectedTeacher != null)
        {
            await ShowTeacherDetailsAsync(SelectedTeacher.Id);
        }
    }

    private Task<bool> ConfirmAsync(string message)
    {
        return Task.FromResult(true);
    }
}
